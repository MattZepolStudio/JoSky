# Toutes ces variables sont optionnelles.

# Sauvegarde des parties sur Upstash Redis (recommandé sur Render gratuit,
# dont le disque est effacé à chaque redémarrage).
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sans Upstash, les parties sont sauvegardées dans ce fichier.
DATA_FILE=".data/rooms.json"

# Durées en millisecondes.
TURN_MS="60000"
ABSENT_TURN_MS="30000"
REVEAL_MS="45000"
